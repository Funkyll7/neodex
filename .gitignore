# Cache des outils : CSV PokeAPI et ~2700 sprites (plus de 300 Mo).
# Entierement reconstructible avec tools/fetch_sprites.py et tools/build_dataset.py.
tools/.cache/

# Captures d'ecran de Pokemon HOME : elles restent en local.
# GitHub Pages sert le depot tel quel, meme prive — les versionner reviendrait
# a les publier. tools/read_screenshots.py les relit depuis ce dossier ;
# data/collection.json, lui, est bien versionne.
photo/

# Reglages locaux de l'outillage, propres a une machine
.claude/settings.local.json

# Systeme / editeurs
# ._xxx : les « resource forks » que macOS depose a cote de chaque fichier
# quand le depot vit sur un disque exFAT / FAT, comme ici.
._*
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Source d'origine de la pastille Gigamax : 966 Ko, aucun script ne s'en sert
# (gigamax.png et gigamax-nb.png sont deja versionnes, prets a l'emploi).
# Les autres sources, elles, alimentent tools/crop_logos.ps1 et make_logos.ps1.
assets/img/sources/gigamax.png

# Memes raisons : les deux logotypes officiels pesent 730 Ko a eux deux, alors
# que les versions reduites servies par le site (logo-home.png, logo-go.png)
# font 15 Ko chacune et sont versionnees. Les retelecharger prend dix secondes ;
# les garder ici alourdirait chaque clone pour toujours.
assets/img/sources/pokemon-home.png
assets/img/sources/pokemon-go.png

# Modeles de dessin fournis par l'utilisateur pour la couronne et le laurier des
# cadres de vignette. Ce sont des visuels de BANQUE, filigranes sur toute leur
# surface : les versionner reviendrait a publier un filigrane au coin de chaque
# vignette terminee, et a redistribuer une image sous licence. Les ornements du
# site sont redessines d'apres eux, en SVG, dans assets/css/components.css.
assets/img/sources/couronne logo.png
assets/img/sources/couronne pixel art.webp
assets/img/sources/laurier 3d.jpg
assets/img/sources/laurier pixel art.jpg

# Fond de la carte postale : une image de l'anime, fournie comme REFERENCE.
# Elle a servi de modele au paysage d'Alola dessine dans ui/carte-partage.js —
# ciel, montagne turquoise, jungle, palmiers, sable. On ne l'embarque pas : elle
# ne nous appartient pas, elle est floue (capture upscalee), et un dessin
# vectoriel reste net a n'importe quelle taille de carte.
assets/img/sources/postcard background.png

# Les quatre logos d'extension, meme raison que pokemon-home.png et
# pokemon-go.png plus haut : 376 Ko de sources pour 34 Ko de vignettes servies.
# Les quatre PNG de assets/img/dlc/ sont versionnes, prets a l'emploi, et
# tools/crop_dlc_logos.ps1 refabrique tout en une commande le jour ou l'on veut
# une autre taille — a condition de retelecharger ces sources, ce qui prend dix
# secondes. Les garder ici alourdirait chaque clone pour toujours.
# Celle de l'Ile de l'Armure pese a elle seule 160 Ko : c'est une illustration
# complete, un paysage de Galar dont on n'extrait que le blason.
assets/img/sources/logo dlc the crown thundra.png
assets/img/sources/isle armor dlc logo.jpg
assets/img/sources/dlc zone zero.png
assets/img/sources/logo mega dimension.avif
