# Cache des outils : CSV PokeAPI et ~2700 sprites (plus de 300 Mo).
# Entierement reconstructible avec tools/fetch_sprites.py et tools/build_dataset.py.
tools/.cache/

# Captures d'ecran de Pokemon HOME : elles restent en local.
# GitHub Pages sert le depot tel quel, meme prive — les versionner reviendrait
# a les publier. tools/read_screenshots.py les relit depuis ce dossier ;
# data/collection.json, lui, est bien versionne.
photo/

# Reglages locaux de l'outillage, propres a une machine
.claude/settings.local.json

# Systeme / editeurs
# ._xxx : les « resource forks » que macOS depose a cote de chaque fichier
# quand le depot vit sur un disque exFAT / FAT, comme ici.
._*
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Source d'origine de la pastille Gigamax : 966 Ko, aucun script ne s'en sert
# (gigamax.png et gigamax-nb.png sont deja versionnes, prets a l'emploi).
# Les quatre autres sources, elles, alimentent tools/crop_logos.ps1.
assets/img/sources/gigamax.png
